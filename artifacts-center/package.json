{
  "name": "@local/artifacts-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "产物中心：在左侧边栏按项目汇总 Agent 生成的产物文件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeX852/dsh-plugins.git",
    "directory": "artifacts-center"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}